Ticket Count = DISTINCTCOUNT(customer_tickets[ticket_id])
Open Tickets = CALCULATE([Ticket Count], customer_tickets[status] = "Open")
Average First Response (Minutes) = AVERAGE(customer_tickets[first_response_minutes])
Average Resolution (Hours) = AVERAGE(customer_tickets[resolution_hours])
Average CSAT = AVERAGE(customer_tickets[csat_score])
High Priority Open = CALCULATE([Ticket Count], customer_tickets[status] = "Open", customer_tickets[priority] = "High")

